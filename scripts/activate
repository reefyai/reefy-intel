#!/bin/sh
set -eu

mkdir -p /etc/cdi
python3 - <<'PY'
import glob
import json
import os


def write(kind, name, paths):
    document = {
        'cdiVersion': '0.6.0',
        'kind': kind,
        'devices': [{
            'name': 'all',
            'containerEdits': {
                'deviceNodes': [{'path': path} for path in paths],
            },
        }],
    }
    temporary = f'/etc/cdi/{name}.json.tmp'
    destination = f'/etc/cdi/{name}.json'
    with open(temporary, 'w') as stream:
        json.dump(document, stream, sort_keys=True, indent=2)
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, destination)


for provider_file in ('intel-gpu.json', 'intel-npu.json'):
    try:
        os.remove(f'/etc/cdi/{provider_file}')
    except FileNotFoundError:
        pass

gpu = sorted(glob.glob('/dev/dri/card*') + glob.glob('/dev/dri/renderD*'))
npu = sorted(glob.glob('/dev/accel/accel*'))
resources = []
if gpu:
    write('intel.com/gpu', 'intel-gpu', gpu)
    resources.append('intel.com/gpu=all')
if npu:
    write('intel.com/npu', 'intel-npu', npu)
    resources.append('intel.com/npu=all')

if resources:
    print('Intel provider activated: ' + ', '.join(resources))
else:
    print('No usable Intel GPU or NPU device nodes; activation is a no-op')
PY
