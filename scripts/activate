#!/bin/sh
set -eu

IFS=:
set -- ${REEFY_ARTIFACT_MOUNTS:?}
unset IFS
COMMON=${1:?missing common Intel layer}
KERNEL_LAYER=${2:?missing Intel kernel layer}
TOOLS=${3:?missing Intel tools layer}
KERNEL_RELEASE=$(uname -r)
MODULE_SOURCE="$KERNEL_LAYER/lib/modules/$KERNEL_RELEASE/extra/intel"
I915_FIRMWARE_SOURCE="$COMMON/lib/firmware/i915"
XE_FIRMWARE_SOURCE="$COMMON/lib/firmware/xe"
NPU_FIRMWARE_SOURCE="$COMMON/lib/firmware/intel/vpu"
XPU_SMI_ROOT=/run/reefy-xpu-smi

[ -d "$MODULE_SOURCE" ]
[ -d "$I915_FIRMWARE_SOURCE" ]
[ -d "$XE_FIRMWARE_SOURCE" ]
[ -d "$NPU_FIRMWARE_SOURCE" ]
[ -x "$TOOLS/bin/xpu-smi" ]
[ -x "$TOOLS/bin/xpu-smi.real" ]
[ -d "$TOOLS/lib" ]
[ -d "$TOOLS/share/xpum/resources/config" ]

bind_read_only() {
    source=$1
    target=$2
    mkdir -p "$target"
    if ! mountpoint -q "$target"; then
        mount --bind "$source" "$target"
        mount -o remount,bind,ro,nodev,nosuid "$source" "$target"
    fi
}

bind_file_read_only() {
    source=$1
    target=$2
    mkdir -p "$(dirname "$target")"
    touch "$target"
    if ! mountpoint -q "$target"; then
        mount --bind "$source" "$target"
        mount -o remount,bind,ro,nodev,nosuid "$source" "$target"
    fi
}

bind_read_only "$MODULE_SOURCE" \
    "/lib/modules/$KERNEL_RELEASE/extra/intel"
bind_read_only "$I915_FIRMWARE_SOURCE" /lib/firmware/i915
bind_read_only "$XE_FIRMWARE_SOURCE" /lib/firmware/xe
bind_read_only "$NPU_FIRMWARE_SOURCE" /lib/firmware/intel/vpu
bind_read_only "$TOOLS" "$XPU_SMI_ROOT"
bind_read_only "$XPU_SMI_ROOT/share/xpum" /usr/share/xpum
bind_file_read_only "$XPU_SMI_ROOT/bin/xpu-smi" /usr/bin/xpu-smi

mkdir -p /run/cdi
rm -f /run/cdi/intel-gpu.json /run/cdi/intel-gpu.tmp.json \
    /run/cdi/intel-npu.json /run/cdi/intel-npu.tmp.json \
    /etc/cdi/intel-gpu.json /etc/cdi/intel-npu.json

depmod "$KERNEL_RELEASE"

# These modules use their own PCI/ACPI match tables. Loading all three lets
# the matched Intel driver bind without keeping product-ID policy in Reefy OS.
for module in xe i915 intel_vpu; do
    modprobe "$module"
    echo "Intel provider loaded $module"
done

# Module loading can return before udev has created every matching device
# node. Let queued uevents drain before discovery, then retain a bounded
# stability check below for drivers that finish probing asynchronously.
if command -v udevadm >/dev/null 2>&1; then
    udevadm settle --timeout=10 || true
fi

python3 - <<'PY'
import glob
import json
import os
import time


def bound_driver(path):
    driver = os.path.join(path, 'device', 'driver')
    if not os.path.islink(driver):
        return ''
    return os.path.basename(os.path.realpath(driver))


def device_nodes(pattern, drivers, directory):
    paths = []
    for sysfs_path in sorted(glob.glob(pattern)):
        if bound_driver(sysfs_path) not in drivers:
            continue
        device = os.path.join(directory, os.path.basename(sysfs_path))
        if os.path.exists(device):
            paths.append(device)
    return paths


def discover():
    gpu = device_nodes(
        '/sys/class/drm/card[0-9]*', {'i915', 'xe'}, '/dev/dri')
    gpu.extend(device_nodes(
        '/sys/class/drm/renderD*', {'i915', 'xe'}, '/dev/dri'))
    npu = device_nodes(
        '/sys/class/accel/accel*', {'intel_vpu'}, '/dev/accel')
    return sorted(set(gpu)), sorted(set(npu))


def write(kind, name, paths):
    document = {
        'cdiVersion': '0.6.0',
        'kind': kind,
        'devices': [{
            'name': 'all',
            'containerEdits': {
                'deviceNodes': [{'path': path} for path in paths],
            },
        }],
    }
    temporary = f'/run/cdi/{name}.tmp.json'
    destination = f'/run/cdi/{name}.json'
    with open(temporary, 'w') as stream:
        json.dump(document, stream, sort_keys=True, indent=2)
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, destination)


gpu = []
npu = []
previous = None
stable_attempts = 0
for _attempt in range(40):
    gpu, npu = discover()
    current = (gpu, npu)
    if current == previous and (gpu or npu):
        stable_attempts += 1
    else:
        stable_attempts = 0
    previous = current
    # Require one full second without a resource change. This avoids
    # publishing only the first of GPU or NPU when their probes finish at
    # different times, while retaining the existing ten-second upper bound.
    if stable_attempts >= 4:
        break
    time.sleep(0.25)

resources = []
if gpu:
    write('intel.com/gpu', 'intel-gpu', gpu)
    resources.append('intel.com/gpu=all')
if npu:
    write('intel.com/npu', 'intel-npu', npu)
    resources.append('intel.com/npu=all')

if resources:
    print('Intel provider activated: ' + ', '.join(resources))
else:
    print('Intel drivers found no usable GPU or NPU; activation is a no-op')
PY
